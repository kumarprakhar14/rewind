generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom profile fields
  department    String?
  graduationYear Int?
  
  accounts      Account[]
  sessions      Session[]
  
  // Relations
  memories      Memory[]   @relation("AuthoredMemories")
  taggedIn      Memory[]   @relation("TaggedMemories")
  
  wallScribbles Scribble[] @relation("RecipientScribbles")
  authoredScribbles Scribble[] @relation("AuthoredScribbles")
  
  comments      Comment[]
  reactions     Reaction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Memory {
  id          String   @id @default(cuid())
  title       String
  story       String   @db.Text
  date        DateTime
  event       String?
  location    String?
  mediaUrl    String?  // Cloudinary URL
  
  authorId    String
  author      User     @relation("AuthoredMemories", fields: [authorId], references: [id])
  
  taggedUsers User[]   @relation("TaggedMemories")
  
  comments    Comment[]
  reactions   Reaction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Scribble {
  id           String   @id @default(cuid())
  text         String   @db.Text
  isAnonymous  Boolean  @default(false)
  color        String   @default("black")
  
  // Position data (x, y, rotation) for the canvas
  posX         Float    @default(0)
  posY         Float    @default(0)
  rotation     Float    @default(0)
  
  authorId     String?  // Nullable for true anonymity if needed, or linked but flagged anonymous
  author       User?    @relation("AuthoredScribbles", fields: [authorId], references: [id])
  
  recipientId  String
  recipient    User     @relation("RecipientScribbles", fields: [recipientId], references: [id])
  
  createdAt    DateTime @default(now())
}

model Comment {
  id          String   @id @default(cuid())
  text        String   @db.Text
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  memoryId    String
  memory      Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model Reaction {
  id          String   @id @default(cuid())
  emoji       String
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  memoryId    String
  memory      Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  
  @@unique([authorId, memoryId, emoji])
}
